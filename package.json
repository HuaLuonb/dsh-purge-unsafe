{
  "name": "dsh-purge-unsafe",
  "version": "0.1.0",
  "description": "DeepSeek Harness 破甲插件（dsh-purge-safe 的界面与文本重做版）：无激活词、提示词常驻、资产批量导入，适配 0.2.x rc1–rc5",
  "type": "module",
  "main": "lib/unsafe/index.js",
  "exports": {
    ".": {
      "default": "./lib/unsafe/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge-unsafe": "bin/dsh-purge-safe.js"
  },
  "files": [
    "lib/unsafe",
    "lib/redteam",
    "bin",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "presets/unsafe-*.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test": "node test/smoke.mjs && node test/compat-matrix.mjs"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.2-rc.3",
  "dshTargets": [
    "0.2.0-rc.1",
    "0.2.0-rc.2",
    "0.2.1-rc.1",
    "0.2.2-rc.3",
    "0.2.2-rc.4",
    "0.2.2-rc.5"
  ]
}
